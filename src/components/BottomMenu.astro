---
import { site } from '../data/site';

interface Props {
  activePage: 'about' | 'notes';
}

const { activePage } = Astro.props;
---

<nav class="bottom-menu" aria-label="Main navigation">
  <div class="bottom-menu-inner">
    <div class="bottom-menu-left">
        <a href={`mailto:${site.email}`}><u>email</u></a>
    </div>

    <div class="bottom-menu-center">
      <a href="/" aria-current="page">{site.name}</a>
    </div>

    <div class="bottom-menu-right">
      <a href={site.phoneHref}><u>tel</u></a>
    </div>
  </div>
</nav>
