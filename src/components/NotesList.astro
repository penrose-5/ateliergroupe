---
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => data.published === true);
const sorted = allNotes.sort((a, b) => a.data.rank - b.data.rank);
---

{sorted.map(async (note) => {
  const { Content } = await note.render();
  const images = note.data.images || [];
  const instruction = note.data.carouselInstruction || 'Click on the image to carousel them';

  return (
    <section class="note-full">
      <header class="note-full-header">
        <h2 class="note-full-title">{note.data.title}</h2>
        {note.data.displayDate && <p class="note-full-date">{note.data.displayDate}</p>}
      </header>

      {images.length > 0 && (
        <div class="carousel" data-carousel>
          <div class="carousel-stage">
            {images.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class:list={['carousel-img', { active: i === 0 }]}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}
          </div>

          <div class="carousel-info">
            <span class="carousel-counter">1/{images.length}</span>
            <span class:list={[
              'carousel-instruction',
              { 'is-static': images.length === 1 }
            ]}>
              {images.length === 1
                ? images[0].alt
                : `* ${instruction}`}
            </span>
          </div>
        </div>
      )}

      <div class="note-full-body body-text">
        <Content />
      </div>

      {note.data.pdf && (
        <a class="note-full-pdf" href={note.data.pdf} target="_blank" rel="noopener noreferrer">
          {note.data.pdfLabel || 'Download PDF'}
        </a>
      )}
    </section>
  );
})}

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const imgs = carousel.querySelectorAll<HTMLImageElement>('.carousel-img');
    const counter = carousel.querySelector('.carousel-counter');
    const instruction = carousel.querySelector('.carousel-instruction');
    const stage = carousel.querySelector('.carousel-stage') as HTMLElement | null;

    if (!stage || imgs.length <= 1) return;

    let current = 0;
    let hasStarted = false;

    stage.style.cursor = 'pointer';

    stage.addEventListener('click', () => {
      imgs[current].classList.remove('active');

      current = (current + 1) % imgs.length;

      imgs[current].classList.add('active');

      if (counter) {
        counter.textContent = `${current + 1}/${imgs.length}`;
      }

      if (instruction) {
        instruction.textContent = imgs[current].alt || '';
      }

      if (!hasStarted) {
        carousel.classList.add('started');
        hasStarted = true;
      }
    });
  });
</script>