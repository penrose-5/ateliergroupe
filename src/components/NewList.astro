---
import { getCollection } from 'astro:content';

const allNews = await getCollection('news', ({ data }) => data.published !== false);
const sorted = allNews.sort((a, b) => a.data.rank - b.data.rank);
---

{sorted.map(async (item) => {
  const { Content } = await item.render();
  return (
    <div class="news-item">
      <p class="news-item-title">{item.data.title}</p>
      {item.data.displayDate && <p class="news-item-date">{item.data.displayDate}</p>}
      <div class="news-item-body">
        <Content />
      </div>
    </div>
  );
})}
