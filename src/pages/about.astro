---
import VersoLayout from '../layouts/VersoLayout.astro';
import ProjectsList from '../components/ProjectsList.astro';
import PeopleList from '../components/PeopleList.astro';
import OfficeDetails from '../components/OfficeDetails.astro';
import atelierImage from '../assets/ATELIERGROUPE_000.jpg';

const aboutStatement = `ATELIERGROUPE is an architecture office based in Geneva.
It works through all sizes and with all stakeholders.

If the city is the most beautiful invention by human beings,
its ideology must be convinced to be at the service of life.

This might be our preferred suggestion, and we try to enhance it every time: with least possible means, and biggest potential effect.

As a side, we are taking <a href="/notes" target="_blank">notes from architecture</a>.`;
---

<VersoLayout title="About — ATELIERGROUPE" activePage="about">
  <div class="about-page">
    <div class="body-text">
      {aboutStatement.split('\n\n').map((para) => (
        <p set:html={para} />
      ))}
    </div>

    <figure class="about-image">
      <img src={atelierImage.src} alt="ATELIERGROUPE" />
    </figure>

    <div class="meta-text">
      <ProjectsList />
    </div>

    <div class="meta-text">
      <p class="person-intro">ATELIERGROUPE is Frederik Dahlqvist, Albin Mehmeti, Alexander Wegener and collects experiences from Studio Paola Viganò, OFFICE KGDVS, Seyler & Lucan and DOGMA.</p>
      <PeopleList />
    </div>
  </div>

<OfficeDetails/>

</VersoLayout>